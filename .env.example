# ── Database ──────────────────────────────────────────────
POSTGRES_USER=eldertable
POSTGRES_PASSWORD=eldertable_secret
POSTGRES_DB=eldertable
DATABASE_URL="postgresql://eldertable:eldertable_secret@localhost:5432/eldertable"

# ── API ───────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ── Discord OAuth2 ────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# ── Discord Bot ───────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Internal API (bot → api) ──────────────────────────────
INTERNAL_API_URL=http://localhost:3001
INTERNAL_API_SECRET=internal-secret-change-me

# ── Storage (S3 / Cloudflare R2) ─────────────────────────
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=eldertable
S3_REGION=auto
S3_PUBLIC_URL=

# ── YouTube Data API ──────────────────────────────────────
YOUTUBE_API_KEY=

# ── Spotify API ───────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
