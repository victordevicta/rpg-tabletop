{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "youtube"],
    "paths": {
      "@eldertable/shared": ["../../packages/shared/src"],
      "@eldertable/dice-engine": ["../../packages/dice-engine/src"],
      "@eldertable/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["src"]
}
